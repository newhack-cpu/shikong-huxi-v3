# 时空呼吸 v3.5 环境变量配置示例
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 填入你的真实 key
#   3. 加载到 shell: 
#      Linux/Mac: source .env  或  export $(cat .env | xargs)
#      Windows PowerShell: Get-Content .env | foreach { if ($_ -match "^(.+)=(.+)$") { Set-Item "env:$($matches[1])" $matches[2] } }
#   4. .env 文件已加入 .gitignore, 不会被提交

# OpenAQ API Key (免费注册: https://explore.openaq.org/register)
# 用于 real_multi_city_collector.py
OPENAQ_API_KEY=your_openaq_key_here

# WAQI Token (备用, https://aqicn.org/data-platform/token/)
# 仅用于实时连通性测试, 不能查历史
WAQI_TOKEN=your_waqi_token_here

# DeepSeek API Key (可选, 用于 app.py 的智能问答深度模式)
# 注册: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here
